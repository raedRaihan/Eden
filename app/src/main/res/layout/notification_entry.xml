<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationFrame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:background="@drawable/animal_frame_and_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/newNotificationIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/notification_unread_circle"
            android:contentDescription="Unread notification"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_unread" />

        <TextView
            android:id="@+id/notificationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:breakStrategy="high_quality"
            android:ellipsize="none"
            android:lineSpacingExtra="3dp"
            android:scrollHorizontally="false"
            android:text="Notification"
            android:textColor="#172B4D"
            android:textSize="15sp" />

    </LinearLayout>

    <Button
        android:id="@+id/markNotificationRead"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/mark_notification_read_description"
        android:text="@string/notification_read"
        android:textAllCaps="false" />

</LinearLayout>
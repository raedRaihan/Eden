<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFBEA"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFE89A"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/dashboard_heading"
        android:textColor="#393224"
        android:textSize="24sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/dashboard_sample_name"
        android:textColor="#393224"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dashboard_sample_description"
        android:textColor="#393224"
        android:textSize="16sp" />
</LinearLayout>

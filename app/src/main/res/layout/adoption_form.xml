<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/afTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adoption_title"
            android:textSize="24sp" />

        <ProgressBar
            android:id="@+id/adoptionLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/adoptionStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/adoptionFormFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Housing" />

            <Spinner
                android:id="@+id/adoptionHousingInput"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pet-care experience" />

            <Spinner
                android:id="@+id/adoptionExperienceInput"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Do you have other pets?" />

            <Spinner
                android:id="@+id/adoptionOtherPetsInput"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="How long may the pet be alone each day?" />

            <Spinner
                android:id="@+id/adoptionHoursAloneInput"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <EditText
                android:id="@+id/adoptionReasonInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top|start"
                android:hint="Why do you want to adopt this pet?"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="250"
                android:minLines="3" />

            <EditText
                android:id="@+id/adoptionNotesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top|start"
                android:hint="Anything else we should know? (optional)"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="250"
                android:minLines="2" />

            <CheckBox
                android:id="@+id/adoptionResponsibilityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="I understand the time, financial, and veterinary responsibilities of adoption." />

            <Button
                android:id="@+id/adoptionReviewButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/visit_review_title" />
        </LinearLayout>

        <Button
            android:id="@+id/adoptionBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/visit_back" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/vfTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/visit_title"
        android:textSize="24sp" />

    <Button
        android:id="@+id/visitDateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/visit_choose_date" />

    <Button
        android:id="@+id/visitTimeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/visit_choose_time" />

    <EditText
        android:id="@+id/visitNotesInput"
        android:layout_width="match_parent"
        android:layout_height="179dp"
        android:layout_marginTop="12dp"
        android:autofillHints="Any Additional Notes for the Visitation Appointment"
        android:background="#D3D3D3"
        android:ems="10"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:padding="8dp"
        android:hint="@string/notes" />

    <Button
        android:id="@+id/visitReviewButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/purple_500"
        android:textColor="@color/white"
        android:text="@string/visit_review_title" />

    <TextView
        android:id="@+id/visitErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#B3261E"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/visitBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#FF0000"
        android:text="@string/visit_back" />
</LinearLayout>

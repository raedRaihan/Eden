<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <ProgressBar
        android:id="@+id/visitLoadingSpinner"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/visit_checking"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorOrLoadText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <Button
        android:id="@+id/visitRetryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/visit_retry"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bookingFormContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/vfTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/visit_title"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/visitDateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/visit_choose_date" />

                <Button
                    android:id="@+id/visitTimeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/visit_choose_time" />

                <EditText
                    android:id="@+id/visitNotesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:maxLength="500"
                    android:layout_marginTop="12dp"
                    android:importantForAutofill="no"
                    android:background="#D3D3D3"
                    android:ems="10"
                    android:gravity="start|top"
                    android:hint="@string/notes"
                    android:inputType="textMultiLine"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/visitReviewButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/purple_500"
                    android:text="@string/visit_review_title"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/visitErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="#B3261E"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/visitBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/visit_back"
            android:textColor="@color/purple_500" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/existingAppointmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/appointmentSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

        </ScrollView>

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#cc0000"
            android:text="@string/cancel_appointment"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/visitBackButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/visit_back"
            android:textColor="@color/purple_500" />

    </LinearLayout>

</LinearLayout>

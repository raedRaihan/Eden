<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/vfTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/visit_title"
        android:textSize="24sp" />

    <Button
        android:id="@+id/visitDateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/visit_choose_date" />

    <Button
        android:id="@+id/visitTimeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/visit_choose_time" />

    <Button
        android:id="@+id/visitBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/visit_back" />
</LinearLayout>

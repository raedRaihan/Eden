<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="#9abae1"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/medicalForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:padding = "26dp"

        >

        <TextView
            android:id="@+id/veterinarianName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:text="Veterinarian: " />

        <TextView
            android:id="@+id/lastUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:text="Last Updated: " />

        <TextView
            android:id="@+id/medications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:text="Medications: " />

        <TextView
            android:id="@+id/vaccines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:text="Vaccines: " />

        <TextView
            android:id="@+id/allergies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:text="Allergies: " />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="15dp"
            android:textColor="#FFFFFF"
            android:text="Doctor Visitation History" />

        <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/doctorVisitsTable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="20dp"
            android:stretchColumns="1">
            <TableRow>
                <TextView
                    android:text="Date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:padding="3dip" />
                <TextView
                    android:text="Treatment Notes"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:padding="3dip" />
                <TextView
                    android:text="Weight/Temp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:gravity="right"
                    android:padding="3dip" />
            </TableRow>



        </TableLayout>

        <Button
            android:id="@+id/returnToPet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:text="Go back to pet profile" />



    </LinearLayout>

</ScrollView>